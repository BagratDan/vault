{
  "name": "vault",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.17.0 <23"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r --parallel test",
    "test:unit": "pnpm -r --parallel test:unit",
    "test:int": "pnpm -r --parallel test:int",
    "e2e": "pnpm --filter @vault/e2e test",
    "lint": "eslint packages/ tools/ e2e/",
    "typecheck": "pnpm -r --parallel typecheck",
    "dev": "pnpm --filter @vault/app dev",
    "start": "node packages/app/dist/index.js"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@typescript-eslint/eslint-plugin": "^8.12.0",
    "@typescript-eslint/parser": "^8.12.0",
    "eslint": "^9.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "require-asset": "^1.2.2"
  }
}
